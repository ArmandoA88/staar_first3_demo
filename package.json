{
  "name": "staar-problem-browser-desktop",
  "private": true,
  "version": "0.1.1",
  "description": "Tauri desktop packaging for the STAAR Problem Browser.",
  "scripts": {
    "tauri": "tauri",
    "tauri:stage": "node scripts/run_python.js scripts/stage_tauri_frontend.py",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:root": "tauri build --no-bundle && node scripts/copy_tauri_release_exe.js",
    "tauri:build:msi:root": "tauri build --bundles msi --config src-tauri/tauri.windows.msi.root.conf.json && node scripts/copy_tauri_release_msi.js",
    "tauri:build:dmg:root": "tauri build --target universal-apple-darwin --bundles dmg && node scripts/copy_tauri_release_dmg.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5"
  }
}
